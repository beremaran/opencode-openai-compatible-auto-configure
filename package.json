{
  "name": "@beremaran/opencode-openai-compatible-auto-configure",
  "version": "0.3.0",
  "description": "OpenCode 2 plugin that discovers models from OpenAI-compatible providers.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/v2.ts",
  "types": "./src/v2.ts",
  "exports": {
    ".": {
      "types": "./src/v2.ts",
      "default": "./src/v2.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "src",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/beremaran/opencode-openai-compatible-auto-configure",
  "bugs": {
    "url": "https://github.com/beremaran/opencode-openai-compatible-auto-configure/issues"
  },
  "engines": {
    "node": ">=22.6",
    "opencode": ">=2 <3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "test:e2e": "bash test/e2e.sh",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openai-compatible",
    "model-discovery",
    "provider",
    "llm",
    "typescript"
  ],
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-openai-compatible-auto-configure.git"
  },
  "funding": "https://github.com/sponsors/beremaran",
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.11 || ^0.0.0-beta"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.11",
    "@types/node": "^24",
    "typescript": "^5.6.0"
  }
}
