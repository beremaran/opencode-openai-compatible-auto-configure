{
  "name": "@beremaran/opencode-openai-compatible-auto-configure",
  "version": "0.2.0",
  "description": "Register multiple OpenAI-compatible API endpoints and auto-configure their models in opencode by fetching GET {baseURL}/models at startup.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/v1.ts",
  "types": "./src/v2.ts",
  "exports": {
    ".": {
      "types": "./src/v2.ts",
      "default": "./src/v2.ts"
    },
    "./server": {
      "types": "./src/index.ts",
      "default": "./src/v1.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/beremaran/opencode-openai-compatible-auto-configure",
  "bugs": {
    "url": "https://github.com/beremaran/opencode-openai-compatible-auto-configure/issues"
  },
  "engines": {
    "node": ">=22.6",
    "opencode": ">=1.18.11 <3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "test:e2e": "bash test/e2e.sh",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openai-compatible",
    "models",
    "auto-configure",
    "provider",
    "llm",
    "api"
  ],
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-openai-compatible-auto-configure.git"
  },
  "funding": "https://github.com/sponsors/beremaran",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.11 || ^0.0.0-beta"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.11",
    "@types/node": "^24",
    "typescript": "^5.6.0"
  }
}
